{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speechify",
  "version": "0.1.0",
  "identifier": "org.speechify.spfy.gui",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Speechify",
        "width": 940,
        "height": 720,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Speechify Open-Source Reimplementation",
    "shortDescription": "Speechify text-to-speech",
    "longDescription": "Pick a voice, type or paste text, hear it, and save the WAV. Drives spfy_synth as a subprocess, so the audio is byte-identical to the CLI."
  }
}
